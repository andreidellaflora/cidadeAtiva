<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CidadeAtiva"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginTop="40dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Criar uma conta"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="35dp"/>

        <!-- NOME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#444444"/>

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite seu nome"
            android:inputType="textPersonName"
            android:padding="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>

        <!-- EMAIL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-mail"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#444444"/>

        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite seu e-mail"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>

        <!-- SENHA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#444444"/>

        <EditText
            android:id="@+id/edtSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite sua senha"
            android:inputType="textPassword"
            android:padding="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>

        <!-- CONFIRMAR SENHA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar senha"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#444444"/>

        <EditText
            android:id="@+id/edtConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite a senha novamente"
            android:inputType="textPassword"
            android:padding="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="30dp"/>

        <!-- CADASTRAR -->

        <Button
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CRIAR CONTA"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#6E4DB3"/>

        <!-- VOLTAR -->

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VOLTAR"
            android:textColor="#6E4DB3"
            android:backgroundTint="#E9E1F5"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>